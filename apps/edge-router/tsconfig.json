{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The Worker is plain JavaScript with JSDoc types, so Terraform can upload src/worker.js as is.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "lib": ["ES2024", "DOM"],
    "verbatimModuleSyntax": false
  },
  "include": ["src", "test"]
}
