{
  "name": "@failover-sentry/regional-app",
  "version": "0.1.0",
  "private": true,
  "description": "The protected workload: one instance per region, with a simulated primary/replica database, chaos switches and a signed replication webhook.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@failover-sentry/contracts": "0.1.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  }
}
