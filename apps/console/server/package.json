{
  "name": "@failover-sentry/console-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend of the Failover Sentry console: GitHub sign-in, the sentry's state as Server-Sent Events, operator actions as Temporal Updates, chaos controls and the replication webhook gateway. Serves the Vue app.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@failover-sentry/contracts": "0.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@temporalio/client": "1.26.0",
    "@temporalio/common": "1.26.0",
    "@temporalio/envconfig": "1.26.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "zod": "^4.6.7"
  }
}
