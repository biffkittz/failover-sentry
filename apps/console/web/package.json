{
  "name": "@failover-sentry/console-web",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 console of the Failover Sentry: live regional health, failover progress, operator actions and chaos controls.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@failover-sentry/contracts": "0.1.0",
    "@tanstack/vue-query": "^5.108.0",
    "pinia": "^4.1.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node24": "^24.0.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
